# ─── ORBIS.ID SSI Backend ────────────────────────────────────────────────────
# Environment configuration file.
# Copy this to .env and fill in your values before running in production.
#   cp .env.example .env

# ─── Server ──────────────────────────────────────────────────────────────────
# Port the SSI backend listens on (default: 3001)
PORT=3001

# Node environment: development, test, or production
NODE_ENV=production

# ─── Security ────────────────────────────────────────────────────────────────
# JWT secret key for signing authentication tokens.
# In production, generate a strong random value:
#   openssl rand -hex 32
# If not set, a random secret is generated on each restart (dev only — invalidates
# all existing sessions on restart).
JWT_SECRET=

# Encryption key for at-rest data encryption.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Database ────────────────────────────────────────────────────────────────
# Path/URL to the team-db CLI binary (used for Turso/SQLite operations).
# In most deployments, 'team-db' is expected on PATH.
# If your deployment uses a different path, set it here.
DATABASE_URL=
TEAM_DB_PATH=team-db
