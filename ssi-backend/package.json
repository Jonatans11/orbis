{
  "name": "orbis-ssi-backend",
  "version": "1.0.0",
  "description": "ORBIS.ID Self-Sovereign Identity Backend — DID management, VC issuance/verification, trust registry",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multibase": "^4.0.6",
    "multiformats": "^14.0.4",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}